rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Formateurs autorisés
    function isTeacher() {
      return request.auth != null && (
        request.auth.token.email == 'jeanphilippe.bolle@cnddinant.be' ||
        request.auth.token.email == 'jeanphilippe@pedagokit.be'
      );
    }

    // Validation du document participant
    function validParticipant() {
      let d = request.resource.data;
      return d.keys().hasAll(['pseudo', 'scores', 'scoresByTheme', 'completedAt'])
          && d.pseudo is string
          && d.pseudo.size() > 0
          && d.pseudo.size() < 60
          && d.scores.reflechi is number
          && d.scores.pragmatique is number
          && d.scores.technophile is number;
    }

    match /sessions/{sessionId} {
      // Lecture publique des métadonnées (pour vérifier qu'un code existe)
      allow read: if true;
      // Création / modification / suppression : formateur uniquement
      allow create, update, delete: if isTeacher();

      match /participants/{participantId} {
        // Lecture publique (pour vue de groupe anonymisée + dashboard prof)
        allow read: if true;
        // Création publique avec validation stricte du schéma
        allow create: if validParticipant();
        // Interdits pour les élèves (rétroactivité impossible)
        allow update, delete: if isTeacher();
      }
    }
  }
}
